<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="350dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/imageWallpaper"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/wallpaper_preview"
                android:scaleType="centerCrop" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtDetailTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/wallpaper_preview"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtPhotographer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:alpha="0.72"
                            android:text="@string/photo_by"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDetailFavorite"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/nav_favorites"
                        android:insetLeft="0dp"
                        android:insetTop="0dp"
                        android:insetRight="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        app:cornerRadius="24dp"
                        app:icon="@android:drawable/btn_star_big_off"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtDetailAiCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/not_analyzed_yet"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/txtDetailAiLabels"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/not_available"
                    android:textSize="16sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRepostWallpaper"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="18dp"
            android:textColor="#6750A4"
            android:text="@string/repost_wallpaper"
            app:cornerRadius="28dp"
            app:icon="@android:drawable/ic_menu_share"
            app:iconTint="#6750A4"
            app:strokeColor="#6750A4" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDetailCollection"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:textColor="#6750A4"
            android:text="@string/add_to_collection"
            app:cornerRadius="28dp"
            app:icon="@android:drawable/ic_menu_add"
            app:iconTint="#6750A4"
            app:strokeColor="#6750A4" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDownloadWallpaper"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#EADDFF"
            android:textColor="#3A2E4F"
            android:text="@string/download_wallpaper"
            app:cornerRadius="28dp"
            app:icon="@android:drawable/stat_sys_download_done"
            app:iconTint="#3A2E4F" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSetHomeWallpaper"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#6750A4"
            android:text="@string/set_home_screen"
            android:textColor="@android:color/white"
            app:cornerRadius="28dp"
            app:icon="@android:drawable/ic_menu_set_as"
            app:iconTint="@android:color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSetLockWallpaper"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#EADDFF"
            android:textColor="#3A2E4F"
            android:text="@string/set_lock_screen"
            app:cornerRadius="28dp"
            app:icon="@android:drawable/ic_lock_lock"
            app:iconTint="#3A2E4F" />

    </LinearLayout>
</ScrollView>
